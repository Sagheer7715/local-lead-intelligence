# Copy to .env and lock it down — core/config.py refuses to read a .env that is
# group- or world-readable:
#
#     cp .env.example .env && chmod 600 .env
#
# Unlike the kit this replaces, this file is actually loaded: core/config.load()
# calls load_env() before reading anything. Real environment variables win over
# the file, so `LLI_MAX_WORKERS=2 python3 -m cli ...` still overrides.

# ── identity ────────────────────────────────────────────────────────────────
# Overpass and Nominatim are free, donation-funded, shared infrastructure. Their
# usage policies require a User-Agent that identifies you with a way to make
# contact. Put something real here before running at any volume.
LLI_CONTACT_URL=https://example.invalid/bot

# ── storage ─────────────────────────────────────────────────────────────────
# LLI_DATA_DIR=./data
# LLI_DB_PATH=./data/leads.db

# ── tier 1: discovery (free, open data, no key) ─────────────────────────────
# LLI_OVERPASS_URL=https://overpass-api.de/api/interpreter
# LLI_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# ── tier 2: enrichment crawl ────────────────────────────────────────────────
# LLI_HTTP_TIMEOUT=10
# LLI_HTTP_MAX_BYTES=400000
# LLI_MAX_WORKERS=6
# LLI_PER_HOST_DELAY=1.0
# LLI_CACHE_TTL_DAYS=30
# LLI_RESPECT_ROBOTS=true

# ── tier 3: optional Google Maps pass (OFF by default) ──────────────────────
# Enabling this runs a real scrape against Google Maps, which is against their
# Terms of Service and puts your IP at risk of temporary rate-limiting.
# LLI_TIER3_ENABLED=false
# SCRAPER_BASE_URL=http://127.0.0.1:8080

# Only needed if you ever put an authenticating proxy in front of the engine.
# The engine itself has no auth; the 127.0.0.1 binding is the boundary.
SCRAPER_API_KEY=

# ── retention ───────────────────────────────────────────────────────────────
# Scraped phones and emails are personal data. `purge` deletes anything not
# seen within this window. Suppression entries are never purged.
# LLI_RETENTION_DAYS=90
